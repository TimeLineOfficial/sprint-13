# Multi-Stage Production Build: Analytics Worker Service
FROM node:20-alpine AS builder
WORKDIR /app
COPY service-manifest.json ./package.json
RUN npm install --omit=dev

FROM node:20-alpine AS runner
WORKDIR /app
RUN addgroup -S apextrack && adduser -S apextrack -G apextrack
COPY --from=builder --chown=apextrack:apextrack /app/node_modules ./node_modules
COPY --chown=apextrack:apextrack service-manifest.json ./package.json
COPY --chown=apextrack:apextrack worker.js ./
USER apextrack
EXPOSE 4004
CMD ["node", "worker.js"]
